# Judgment runs on SERV Reasoning. Dolphin open models are an optional second choice.
SERV_API_KEY=
SERV_MODEL=               # a model id from the SERV catalog
DOLPHIN_API_KEY=          # optional; adds Dolphin open models as the second choice
DOLPHIN_MODEL=            # a model id from your Dolphin /models list
JUDGE_PROVIDER=           # set to "dolphin" to try Dolphin before SERV

# Scoring
REPPO_API_KEY=

# Where history and your policy are stored (use a persistent disk in production)
OPENPATH_DATA_DIR=

# Kite Passport (optional). Path to the kpass CLI, logged in with an active session.
KPASS_BIN=
