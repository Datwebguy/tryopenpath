# Judgment runs on SERV Reasoning.
SERV_API_KEY=
SERV_MODEL=               # a model id from the SERV catalog, for example serv-mini
SERV_RULES_MODEL=         # optional: a different SERV model for writing rules from sentences

# Scoring
REPPO_API_KEY=

# Where history and your policy are saved (use a persistent disk in production)
OPENPATH_DATA_DIR=

# Kite Passport (optional). Path to the kpass CLI, logged in with an active session.
KPASS_BIN=
