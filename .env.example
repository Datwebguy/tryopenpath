# Judgment model. Set a key and model for at least one provider.
SERV_API_KEY=
SERV_MODEL=               # a model id from the SERV catalog
DOLPHIN_API_KEY=          # optional; when set, Dolphin runs the judgment step first
DOLPHIN_MODEL=            # a model id from your Dolphin /models list
JUDGE_PROVIDER=           # set to "serv" to try SERV before Dolphin

# Scoring
REPPO_API_KEY=

# Where history and your policy are stored (use a persistent disk in production)
OPENPATH_DATA_DIR=
